VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# E-Mail-Postfach-Anbindung (Edge Function "email-gateway", siehe supabase/functions/email-gateway)
# — Senden + KI-Gesprächszusammenfassung
VITE_EMAIL_GATEWAY_URL=
VITE_EMAIL_GATEWAY_SECRET=

# Posteingang (liest public.eingegangene_emails direkt aus dem "mayer-holding-crm"-Supabase-Projekt,
# befüllt per Webhook — siehe supabase/functions/inbound-email). Projekt-URL + anon/publishable Key,
# zu finden unter Project Settings → API im Supabase-Dashboard dieses Projekts.
VITE_SUPABASE_EMAIL_URL=
VITE_SUPABASE_EMAIL_ANON_KEY=

# Nur für die lokalen Wartungsskripte scripts/migrate-inbox.mjs und scripts/cleanup-inbox.mjs
# (laufen auf dem eigenen Rechner, nicht in Supabase). NICHT per VITE_-Präfix an den Browser
# ausliefern — vollen Admin-Zugriff auf die Datenbank bzw. ein abrechenbares API-Key.
# Am einfachsten einmalig per "sh scripts/setup-local-secrets.sh" in die eigene .env.local
# eintragen, statt hier echte Werte einzutragen.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
